<mujoco model="task_peg_in_hole">
  <include file="panda.xml"/>

  <statistic center="0.3 0 0.4" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="hole_wall" rgba="0.5 0.6 0.7 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Round hole: inner radius 11mm, peg radius 8mm => 3mm radial clearance.
         12 tangential boxes form the cylindrical wall. -->
    <body name="target_hole" pos="0.5 0 0">
      <geom name="hole_bottom" type="cylinder" size="0.014 0.005" pos="0 0 -0.005" rgba="0.2 0.8 0.2 1"/>
      <geom name="wall_0" type="box" size="0.003 0.005 0.02" pos="0.014 0 0.02" euler="0 0 0"
        material="hole_wall" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <geom name="wall_1" type="box" size="0.003 0.005 0.02" pos="0.01212 0.007 0.02" euler="0 0 30"
        material="hole_wall" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <geom name="wall_2" type="box" size="0.003 0.005 0.02" pos="0.007 0.01212 0.02" euler="0 0 60"
        material="hole_wall" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <geom name="wall_3" type="box" size="0.003 0.005 0.02" pos="0 0.014 0.02" euler="0 0 90"
        material="hole_wall" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <geom name="wall_4" type="box" size="0.003 0.005 0.02" pos="-0.007 0.01212 0.02" euler="0 0 120"
        material="hole_wall" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <geom name="wall_5" type="box" size="0.003 0.005 0.02" pos="-0.01212 0.007 0.02" euler="0 0 150"
        material="hole_wall" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <geom name="wall_6" type="box" size="0.003 0.005 0.02" pos="-0.014 0 0.02" euler="0 0 180"
        material="hole_wall" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <geom name="wall_7" type="box" size="0.003 0.005 0.02" pos="-0.01212 -0.007 0.02" euler="0 0 210"
        material="hole_wall" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <geom name="wall_8" type="box" size="0.003 0.005 0.02" pos="-0.007 -0.01212 0.02" euler="0 0 240"
        material="hole_wall" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <geom name="wall_9" type="box" size="0.003 0.005 0.02" pos="0 -0.014 0.02" euler="0 0 270"
        material="hole_wall" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <geom name="wall_10" type="box" size="0.003 0.005 0.02" pos="0.007 -0.01212 0.02" euler="0 0 300"
        material="hole_wall" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <geom name="wall_11" type="box" size="0.003 0.005 0.02" pos="0.01212 -0.007 0.02" euler="0 0 330"
        material="hole_wall" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <site name="hole_center" pos="0 0 0" size="0.005" rgba="1 0 0 0"/>
    </body>
  </worldbody>

  <sensor>
    <force name="ee_force_sensor" site="ft_sensor_site"/>
    <torque name="ee_torque_sensor" site="ft_sensor_site"/>
  </sensor>

  <contact>
    <exclude body1="left_finger" body2="target_hole"/>
    <exclude body1="right_finger" body2="target_hole"/>
  </contact>
</mujoco>
